rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Coleções Públicas (Leitura liberada para o site, edição restrita ao Admin autenticado)
    match /salas/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cardapio/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categorias_cardapio/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /galeria/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /configuracoes/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bloqueios/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Coleções de Reservas (Clientes podem enviar reservas do site, Admin autenticado visualiza e gerencia)
    match /reservas/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /agendamentos/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
